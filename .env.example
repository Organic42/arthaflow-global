# ArthaFlow Global — environment template.
# Copy to .env.local and fill in. NEVER commit real values.

# ── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional. Enables trade-data caching (trade_cache is deny-all under RLS, so
# only a service-role client can reach it). SERVER ONLY — this key bypasses RLS
# entirely, so never expose it to the browser or prefix it with NEXT_PUBLIC_.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Export Saathi (the chat agent) ──────────────────────────────────────────
# Google AI Studio / Gemini key: https://aistudio.google.com/apikey
# Saathi runs on Gemini, not Groq — the agent loop speaks Gemini's
# OpenAI-compatible endpoint. Without this the chat route returns an error.
GEMINI_API_KEY=your-gemini-key

# Optional. Overrides the model without a deploy; defaults to gemini-3.5-flash.
# Note gemini-2.5-* are advertised by the models list but 404 when called, and
# gemini-3.5-flash-lite measured slower AND hungrier than flash on this
# workload — see src/lib/saathi/model.ts before changing this.
# SAATHI_MODEL=gemini-3.5-flash

# ── Document generation ─────────────────────────────────────────────────────
# Still on Groq (llama-3.3-70b) — only /api/generate-document uses this.
GROQ_API_KEY=your-groq-key

# ── Trade data ──────────────────────────────────────────────────────────────
# Free tier: 500 requests/day. Register at https://comtradeplus.un.org
COMTRADE_API_KEY=your-comtrade-key
