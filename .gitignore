# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local Netlify folder
.netlify

# ...but the placeholder template is safe to commit and helps onboarding.
!.env.example

# Source PDFs cached by scripts/build-rodtep.py and build-itchs.py.
# The parsed JSON is vendored; the PDFs are large and re-downloadable.
.rodtep-cache/
itchs-schedule2.pdf

# Agent skills installed via `npx skills add`. Vendored tooling, not project
# source: ~8MB of CSV rule data and scripts, re-installable from skills-lock.json.
.claude/skills/
.agents/
